{
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Dynamic Pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { 
      "type": "string", 
      "required": true 
    },
    "slug": { 
      "type": "uid", 
      "targetField": "title", 
      "required": true 
    },
    "seo": { 
      "type": "component", 
      "repeatable": false, 
      "component": "shared.seo-meta"
    },
    "content_blocks": { 
      "type": "dynamiczone", 
      "components": [
        "blocks.hero-section", 
        "blocks.service-grid", 
        "blocks.rich-text-content",
        "blocks.contact-form"
      ]
    }
  }
}
